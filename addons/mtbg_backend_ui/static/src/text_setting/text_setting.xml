<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mtbg_tours_core.TextSettingField">
        <div class="mtbg_text_setting d-flex align-items-start gap-1 w-100">
            <div class="flex-grow-1 min-w-0"><Base t-props="baseProps"/></div>
            <button type="button" class="btn btn-link btn-sm px-1 text-nowrap mtbg_text_setting_langs"
                    title="Other languages" t-on-click="openLanguages">
                <i class="fa fa-language me-1"/>Languages
            </button>
        </div>
    </t>

    <t t-name="mtbg_tours_core.TextSettingDialog">
        <Dialog title="props.title" size="props.html ? 'xl' : 'lg'">
            <div t-if="main and !props.allLangs" class="mb-3">
                <div class="text-muted small mb-1"><t t-esc="main.name"/> (main language, edited on the page)</div>
                <div t-if="props.html" class="border rounded p-2 bg-light small" t-out="state.values[main.code]"/>
                <div t-else="" class="border rounded p-2 bg-light small" t-esc="state.values[main.code]"/>
            </div>
            <div t-if="!props.allLangs and !others.length" class="alert alert-info mb-0">
                The website has one language. Add languages under Website › Configuration › Settings to translate this text.
            </div>
            <div t-foreach="others" t-as="lang" t-key="lang.code" class="mb-3">
                <label class="form-label fw-bold" t-esc="lang.name"/>
                <div t-if="props.html" class="border rounded mtbg_text_setting_editor">
                    <Wysiwyg config="editorConfig(lang.code)" onLoad="(editor) => this.editors[lang.code] = editor"/>
                </div>
                <textarea t-else="" class="form-control" rows="3" placeholder="Empty: the main text"
                          t-model="state.values[lang.code]"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="save">Save</button>
                <button class="btn btn-secondary" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
