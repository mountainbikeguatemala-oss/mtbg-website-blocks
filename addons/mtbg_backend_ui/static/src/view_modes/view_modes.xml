<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- List · Cards · Kanban, then the action's other views -->
    <t t-name="mtbg_tours_core.ViewModes">
        <nav class="o_mtbg_view_modes btn-group d-print-none" aria-label="View">
            <button t-foreach="modes" t-as="m" t-key="m.key" type="button" class="btn btn-secondary o_switch_view"
                    t-att-class="{'active': m.key === props.mode}" t-attf-data-mtbg-mode="{{m.key}}"
                    t-att-data-tooltip="m.label" t-att-aria-label="m.label" t-on-click="() => this.choose(m.key)">
                <i t-attf-class="{{m.icon}} oi-fw"/>
            </button>
            <button t-foreach="others" t-as="view" t-key="view.type" type="button" class="btn btn-secondary o_switch_view"
                    t-attf-class="o_{{view.type}} {{view.type === props.mode ? 'active' : ''}}" t-att-data-tooltip="view.name" t-att-aria-label="view.name"
                    t-on-click="() => this.switchTo(view.type)">
                <i class="oi-fw" t-att-class="view.icon"/>
            </button>
        </nav>
    </t>
</templates>
