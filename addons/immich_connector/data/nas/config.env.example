# Tour photo service settings. Copy this file to config.env and fill in every line marked REQUIRED.
# The setup wizard on your website fills most of this in for you. Keep config.env private: it holds keys.

# ---- Your website -------------------------------------------------------------------------------
# REQUIRED. Your website address, no trailing slash, e.g. https://www.example.com
SITE_URL=
# REQUIRED. Settings > Immich > "Set up the photo server" on your website (shown once; the wizard fills it in).
NAS_TOKEN=

# ---- Immich (on the same NAS) -------------------------------------------------------------------
# REQUIRED. How this service reaches Immich, e.g. http://192.168.1.50:2283 (your NAS address + Immich port).
IMMICH_URL=
# Optional. The address staff open in their browser for an album (shown on the departure record).
# Leave empty to use IMMICH_URL.
IMMICH_PUBLIC_URL=
# REQUIRED. API key of the shared "Tours" Immich account: log in to Immich as that account >
# Account Settings > API Keys > New API Key (all permissions). This account owns the tour albums.
IMMICH_API_KEY=

# ---- Cloudflare R2 (where clients' photos are served from) --------------------------------------
# REQUIRED. Cloudflare dashboard > R2 > Overview: "Account ID".
R2_ACCOUNT_ID=
# REQUIRED. The bucket name, e.g. tour-photos.
# The photos bucket the website's "Set up photos storage" wizard created (named <site>-photos).
R2_BUCKET=
# REQUIRED. R2 > Manage API tokens > Create token: "Object Read & Write", applied to THIS bucket only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# For reference: the bucket's public custom domain, e.g. https://photos.example.com. The website builds the
# image links; this service does not use it. Set the same value in the website's Tour photos settings.
PUBLIC_BASE_URL=

# ---- Office upload page ------------------------------------------------------------------------
# Port of the upload page on the office network: http://<NAS address>:<UPLOAD_PORT>. Put that address in the
# website's Settings > Tour photos > "Office upload page URL".
UPLOAD_PORT=8090
# Immich's Docker network (its compose project "immich": immich_default). The upload page joins it so the https
# front in tls/ can reach it. Find yours with:  docker network ls
IMMICH_NETWORK=immich_default
# Largest single file accepted on the upload page, in MB: photos and videos.
UPLOAD_MAX_PHOTO_MB=50
UPLOAD_MAX_VIDEO_MB=2048

# ---- Secure office address (the https front in tls/) ---------------------------------------------
# The same name and port as tls/.env (the wizard fills them in). With NAS_HOSTNAME set, this service checks
# https://NAS_HOSTNAME:NAS_HTTPS_PORT/ping every 15 minutes, as a phone at the office would, reads until when the
# certificate is good, and tells the website (Settings > Immich shows it; staff are warned when it stops working).
# Empty: no secure office address, no check.
NAS_HOSTNAME=
NAS_HTTPS_PORT=443
# This NAS's address on the office network (reserve it on the router), e.g. 192.168.1.50: tried with the name when
# the name doesn't resolve, to tell a DNS problem from a stopped https front. Empty: the host of IMMICH_URL.
NAS_LAN_IP=

# ---- Photos ------------------------------------------------------------------------------------
# Watermark. Easiest: upload it on the website (Tours > Configuration > Tour photos); the service picks it up
# and its corner/size/opacity by itself, and those override the values below. Without a website watermark it
# uses this PNG (transparent background) in the data folder; with neither, photos are published unmarked.
WATERMARK_PATH=/data/watermark.png
# Watermark size (share of the photo width), margin from the corner, opacity (0-1), and corner.
WATERMARK_WIDTH=0.15
WATERMARK_MARGIN=0.03
WATERMARK_OPACITY=0.85
WATERMARK_CORNER=bottom-right
# Web copies: long edge in pixels and JPEG quality. Download zips carry full-size copies at ZIP_QUALITY.
WEB_LONG_EDGE=2048
WEB_QUALITY=82
ZIP_QUALITY=90
HEADER_WIDTH=1200
# Videos: web MP4 long edge (1280 or 1920), bitrate, and the looping preview shown in the gallery.
WEB_VIDEO_LONG_EDGE=1280
VIDEO_BITRATE=5M
PREVIEW_SECONDS=3
PREVIEW_WIDTH=480

# ---- Timing and place --------------------------------------------------------------------------
# REQUIRED. Time zone where your tours happen (photo times are read in it), e.g. America/Mexico_City, Europe/Madrid.
TIMEZONE=UTC
TZ=UTC
# How often the service checks the website (new departures, days ready to publish), in minutes.
POLL_MINUTES=5
# How often it collects photos guides sent over mobile data, in minutes.
INBOX_MINUTES=15
# Tight sync: while the website lists departures being uploaded or sent (from the first upload until the gallery and
# its zip are online), the service asks the website about those departures every TIGHT_SYNC_SECONDS (30-60); the
# full round stays every POLL_MINUTES. Needs a website that lists them (otherwise nothing changes).
TIGHT_SYNC_SECONDS=45
# Processing time per round, in minutes (resizing, watermarking, videos), before the service checks the website again.
STAGE_MINUTES=4
# 1 = "Send to clients" tells the website the gallery is online as soon as the photos are copied and the header is
# set; the download zip follows with a second report. Only with a website that accepts a report without the zip
# (otherwise leave 0: the report waits for the zip).
EARLY_SYNCED=0

# ---- Advanced (leave as they are) ---------------------------------------------------------------
# 1 = only log what would happen, change nothing.
DRY_RUN=0
# Album marker and name prefix. Change only for a separate test setup sharing the same Immich.
ALBUM_NS=departure
ALBUM_PREFIX=
# 1 = also sort photos that guides share with the Tours account (Immich partner sharing) by capture time.
SORT_PARTNER_PHOTOS=0
# One-off: create (empty) albums for all departures since this date, e.g. 2026-07-01, then exit.
# Run once with:  docker compose --env-file config.env run --rm -e BACKFILL_FROM=2026-07-01 photos-sync /app/sync.py
BACKFILL_FROM=

# Receipts (optional, off unless RECEIPTS_DIR is set): receipts and payment screenshots found by Immich's CLIP
# search are copied to RECEIPTS_DIR and the photo goes to Immich's trash; borderline ones go to the album
# "Receipts – check"; anything put in the album "Receipts" is moved. Tour day albums are never touched.
# Needs the Immich database settings: add ../immich/.env to the sync service's env_file, and mount the share,
# e.g. volumes: - /path/to/receipts:/receipts
# RECEIPTS_DIR=/receipts
# RECEIPTS_DRY=1          # 1 = only write the plan (/work/receipts_plan.txt); 0 = move
# RECEIPT_AUTO=0.735
# RECEIPT_CHECK=0.765
# PAYMENT_AUTO=0.712
# PAYMENT_CHECK=0.72
