# Tour photo service settings. Copy this file to config.env and fill in every line marked REQUIRED.
# The setup wizard on your website fills most of this in for you. Keep config.env private: it holds keys.

# ---- Your website -------------------------------------------------------------------------------
# REQUIRED. Your website address, no trailing slash, e.g. https://www.example.com
SITE_URL=
# REQUIRED. Settings > Immich > "Set up the photo server" on your website (shown once; the wizard fills it in).
NAS_TOKEN=

# ---- Immich (on the same NAS) -------------------------------------------------------------------
# REQUIRED. How this service reaches Immich, e.g. http://192.168.1.50:2283 (your NAS address + Immich port).
IMMICH_URL=
# Optional. The address staff open in their browser for an album (shown on the departure record).
# Leave empty to use IMMICH_URL.
IMMICH_PUBLIC_URL=
# REQUIRED. API key of the shared "Tours" Immich account: log in to Immich as that account >
# Account Settings > API Keys > New API Key (all permissions). This account owns the tour albums.
IMMICH_API_KEY=

# ---- Cloudflare R2 (where clients' photos are served from) --------------------------------------
# REQUIRED. Cloudflare dashboard > R2 > Overview: "Account ID".
R2_ACCOUNT_ID=
# REQUIRED. The bucket name, e.g. tour-photos.
R2_BUCKET=tour-photos
# REQUIRED. R2 > Manage API tokens > Create token: "Object Read & Write", applied to THIS bucket only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# For reference: the bucket's public custom domain, e.g. https://photos.example.com. The website builds the
# image links; this service does not use it. Set the same value in the website's Tour photos settings.
PUBLIC_BASE_URL=

# ---- Office upload page ------------------------------------------------------------------------
# Port of the upload page on the office network: http://<NAS address>:<UPLOAD_PORT>. Put that address in the
# website's Settings > Tour photos > "Office upload page URL".
UPLOAD_PORT=8090
# Largest single file accepted, in MB.
UPLOAD_MAX_MB=300

# ---- Photos ------------------------------------------------------------------------------------
# REQUIRED. Your watermark: a PNG with a transparent background. Put the file in the data folder next to this
# file and keep this path (/data is the data folder inside the container).
WATERMARK_PATH=/data/watermark.png
# Watermark size (share of the photo width), margin from the corner, opacity (0-1), and corner.
WATERMARK_WIDTH=0.15
WATERMARK_MARGIN=0.03
WATERMARK_OPACITY=0.85
WATERMARK_CORNER=bottom-right
# Web copies: long edge in pixels and JPEG quality. Download zips carry full-size copies at ZIP_QUALITY.
WEB_LONG_EDGE=2048
WEB_QUALITY=82
ZIP_QUALITY=90
HEADER_WIDTH=1200

# ---- Timing and place --------------------------------------------------------------------------
# REQUIRED. Time zone where your tours happen (photo times are read in it), e.g. America/Mexico_City, Europe/Madrid.
TIMEZONE=UTC
TZ=UTC
# How often the service checks the website (new departures, days ready to publish), in minutes.
POLL_MINUTES=5
# How often it collects photos guides sent over mobile data, in minutes.
INBOX_MINUTES=15

# ---- Advanced (leave as they are) ---------------------------------------------------------------
# 1 = only log what would happen, change nothing.
DRY_RUN=0
# Album marker and name prefix. Change only for a separate test setup sharing the same Immich.
ALBUM_NS=departure
ALBUM_PREFIX=
# 1 = also sort photos that guides share with the Tours account (Immich partner sharing) by capture time.
SORT_PARTNER_PHOTOS=0
# One-off: create (empty) albums for all departures since this date, e.g. 2026-07-01, then exit.
# Run once with:  docker compose --env-file config.env run --rm -e BACKFILL_FROM=2026-07-01 photos-sync /app/sync.py
BACKFILL_FROM=
