# Copy to .env (the wizard's zip has it filled in). Not secret.
# The secure office address (a DNS record nas.<domain> -> the NAS's office address, DNS only).
NAS_HOSTNAME=nas.example.com
# 443, or another port when the NAS already uses 443 for its own pages (e.g. 8443).
NAS_HTTPS_PORT=443
# The website's addresses allowed to upload here (space-separated).
SITE_ORIGINS=https://www.example.com https://example.com
