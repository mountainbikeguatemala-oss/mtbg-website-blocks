# The photo server's secure office address: https://{$NAS_HOSTNAME}:{$NAS_HTTPS_PORT}
# - a real certificate (Let's Encrypt) proved through Cloudflare DNS (CLOUDFLARE_API_TOKEN, in tls.env; a real token:
#   a placeholder is refused at start). No local propagation pre-check: many routers intercept LAN DNS
# - /ping answered here: {"ok":true} (the Staff App's "am I on the office network" probe)
# - CORS for the website (SITE_ORIGINS, space-separated; matched with a CEL expression: a plain
#   `header Origin` matcher can't take a space-separated list): the Staff App, an https page on the website, uploads here
# - everything else goes to the office upload page (tour-photos-upload:8090 on the Immich network)
{
	admin off
	auto_https disable_redirects
}

{$NAS_HOSTNAME}:{$NAS_HTTPS_PORT} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		propagation_delay 30s
		propagation_timeout -1
	}

	@site expression `{http.request.header.Origin} in "{$SITE_ORIGINS}".split(" ")`
	header @site {
		Access-Control-Allow-Origin "{http.request.header.Origin}"
		Access-Control-Allow-Private-Network true
		Vary Origin
		defer
	}

	@preflight {
		method OPTIONS
		expression `{http.request.header.Origin} in "{$SITE_ORIGINS}".split(" ")`
	}
	handle @preflight {
		header Access-Control-Allow-Methods "GET, POST, PUT, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, X-File-Name, X-Last-Modified, X-File-Type"
		header Access-Control-Max-Age 600
		respond 204
	}

	handle /ping {
		header Content-Type application/json
		header Cache-Control no-store
		respond `{"ok":true}` 200
	}

	handle {
		reverse_proxy tour-photos-upload:8090 {
			flush_interval -1
			transport http {
				read_timeout 15m
				write_timeout 15m
			}
		}
	}
}
