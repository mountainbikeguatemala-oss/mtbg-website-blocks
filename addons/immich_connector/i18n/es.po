msgid ""
"Secure office address: ✓ working · certificate until %(date)s (checked "
"%(when)s)"
msgstr ""
"Dirección segura de la oficina: ✓ funciona · certificado hasta %(date)s "
"(comprobado %(when)s)"

#. module: immich_connector
#. odoo-python
#: code:addons/immich_connector/models/connector.py:0
