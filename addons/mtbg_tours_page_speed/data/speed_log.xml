<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- the nightly speed log (models/speed_log.py): every night at 02:30 in the business's time zone (Settings ›
         Operator Timezone), then a few pages a minute until the night's list is done; it does nothing while the switch
         is off or Google is not connected. Its time is set by the code (_mtbg_schedule_night), never by an update
         (0.7.5: an update used to push the first night to "tomorrow" again, every time) -->
    <record id="cron_speed_log" model="ir.cron">
        <field name="name">Page speed: nightly speed log (PageSpeed Insights)</field>
        <field name="model_id" ref="model_mtbg_page_speed_log"/>
        <field name="state">code</field>
        <field name="code">model._mtbg_speed_run()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
