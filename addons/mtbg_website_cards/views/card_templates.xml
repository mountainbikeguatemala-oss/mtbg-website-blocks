<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cards in a design (models/card_design.py mtbg_render): a grid of cards. A card: its header (above it, no
         colour), the photo with its top strip, center and bottom strip (each shown always or on hover), and below
         it the text and the footer line. Its colours: CSS variables (light, and dark for dark pages:
         .mtbg-theme-dark), cards.scss. -->
    <template id="cards" name="Cards in a design">
        <!-- the layouts (a card use's, models/card_use.py): a grid (how many side by side by screen width), the one
             slider (slider_templates.xml), a masonry wall (cards of any height in columns), one under another -->
        <t t-set="per" t-value="per or {'lg': columns or 3, 'md': 2, 'sm': 1}"/>
        <t t-set="layout_style" t-value="'--mtbg-cards-lg: %s; --mtbg-cards-md: %s; --mtbg-cards-sm: %s; --mtbg-cards-gap: %s; %s' % (per.get('lg'), per.get('md'), per.get('sm'), gap or '1.5rem', style_vars or '')"/>
        <t t-if="layout == 'slider'">
            <t t-set="slider_style" t-value="style_vars"/>
            <t t-set="slider_class" t-value="'mtbg-cards-slider %s' % (slider_class or '')"/>
            <t t-call="mtbg_website_cards.slider">
                <div t-foreach="cards" t-as="card" class="mtbg-slider__slide"><t t-call="mtbg_website_cards.card"/></div>
            </t>
        </t>
        <div t-else="" t-attf-class="mtbg-cards mtbg-cards--#{layout} mtbg-cards--cols-#{columns or 3} #{use_class or ''}" t-att-style="layout_style">
            <t t-foreach="cards" t-as="card"><t t-call="mtbg_website_cards.card"/></t>
        </div>
    </template>

    <template id="card" name="Card">
        <t t-set="regions" t-value="card['regions']"/>
        <div class="mtbg-card-cell">
            <div t-if="regions['header']['items']" class="mtbg-card__header">
                <t t-foreach="regions['header']['items']" t-as="item"><t t-call="mtbg_website_cards.card_item"/></t>
            </div>
            <!-- (the card and its banners that reach past its edges: a 3D fold round the corner or the edge) -->
            <t t-set="OUTER_BANNERS" t-value="('fold3d', 'wrap3d', 'fold45', 'wrapband', 'bookmark', 'bookmarkpoint', 'sidetag', 'sidepoint')"/>
            <t t-set="outer_banners" t-value="[b for b in (card.get('banners') or []) if b.get('bstyle') in OUTER_BANNERS]"/>
            <t t-set="inner_banners" t-value="[b for b in (card.get('banners') or []) if b.get('bstyle') not in OUTER_BANNERS]"/>
            <div class="mtbg-card__frame">
            <article t-attf-class="mtbg-card mtbg-card--frame-#{settings['frame']} mtbg-card--align-#{settings['align']} mtbg-card--ratio-#{settings['ratio']} mtbg-card--corners-#{settings['corners']} #{'has-shadow' if settings['shadow'] else ''} #{'hover-zoom' if settings['hover_zoom'] else ''} #{'hover-darken' if settings['hover_darken'] else ''}">
                <a t-if="card['url']" class="mtbg-card__link" t-att-href="card['url']" t-att-aria-label="card['name'] or None"/>
                <!-- banners: over the card's top (a corner ribbon, a band, a tag), wherever they were placed -->
                <div t-if="inner_banners" class="mtbg-card__banners">
                    <t t-foreach="inner_banners" t-as="item"><t t-call="mtbg_website_cards.card_item"/></t>
                </div>
                <!-- (the photo and "below": the bubble of a speech-bubble card, the footer under it) -->
                <div class="mtbg-card__main">
                <div t-if="settings['image_size'] != 'none'" class="mtbg-card__media">
                    <img t-if="card['image']" class="mtbg-card__img" loading="lazy" t-att-src="card['image']" t-att-alt="card['name']"/>
                    <div t-else="" class="mtbg-card__img is-empty"/>
                    <div class="mtbg-card__shade"/>
                    <t t-foreach="['top', 'center', 'bottom']" t-as="rkey">
                        <t t-set="region" t-value="regions[rkey]"/>
                        <div t-if="region['items']" t-attf-class="mtbg-card__on mtbg-card__on--#{rkey} #{'has-shade' if region.get('shade') else ''}"
                             t-att-data-show="region['show']">
                            <t t-foreach="region['items']" t-as="item"><t t-call="mtbg_website_cards.card_item"/></t>
                        </div>
                    </t>
                </div>
                <div t-if="regions['below']['items']" class="mtbg-card__body">
                    <t t-foreach="regions['below']['items']" t-as="item"><t t-call="mtbg_website_cards.card_item"/></t>
                </div>
                </div>
                <div t-if="regions['footer']['items']" class="mtbg-card__footer">
                    <t t-foreach="regions['footer']['items']" t-as="item"><t t-call="mtbg_website_cards.card_item"/></t>
                </div>
            </article>
            <div t-if="outer_banners" class="mtbg-card__banners mtbg-card__banners--out">
                <t t-foreach="outer_banners" t-as="item"><t t-call="mtbg_website_cards.card_item"/></t>
            </div>
            </div>
        </div>
    </template>

    <!-- one placed field: its look (plain, pill, button, bar), its icon, its words (its value, or its text with the
         values it names); data-show: always / on hover (on the photo) -->
    <template id="card_item" name="Card field">
        <!-- fields placed "on one line": side by side -->
        <div t-if="item['kind'] == '_row'" class="mtbg-card__row" t-att-data-show="item['show']">
            <t t-foreach="item['items']" t-as="item"><t t-call="mtbg_website_cards.card_item"/></t>
        </div>
        <t t-else="">
        <t t-set="kind" t-value="item['kind']"/>
        <t t-set="val" t-value="item['value']"/>
        <!-- (its bold and capitals: on its words; the ratings': on their labels only) -->
        <t t-set="text_cls" t-value="' '.join(c for c in (item.get('weight') and 'mtbg-card__w-%s' % item['weight'], item.get('case') and 'mtbg-card__case-%s' % item['case']) if c)"/>
        <t t-set="cls" t-value="' '.join(c for c in ('mtbg-card__item mtbg-card__item--%s mtbg-card__k-%s mtbg-card__f-%s' % (item['look'], kind, item['field']), text_cls if kind != 'icons' else '') if c)"/>
        <!-- its text size (the design's item option, % of the design's own): the whole field scaled -->
        <t t-set="text_style" t-value="'; '.join(x for x in ('zoom: %s' % (item['fsize'] / 100.0) if item.get('fsize') else '', 'line-height: %s' % (item['lh'] / 100.0) if item.get('lh') else '') if x)"/>
        <!-- (the ratings: their text size and line height on their labels; the icons have their own size) -->
        <t t-set="item_zoom" t-value="text_style if kind != 'icons' else ''"/>
        <a t-if="item['look'] == 'button'" t-attf-class="#{cls} mtbg-card__btn #{book['class'] if book and item['field'] == 'book' else ''}" t-att-href="card['url'] or None"
           t-att-data-show="item['show']" t-att-style="item_zoom or None">
            <i t-if="item['icon']" t-attf-class="fa #{item['icon']}" aria-hidden="true"/>
            <t t-call="mtbg_website_cards.card_words"/>
        </a>
        <div t-elif="item['look'] in ('corner', 'banner', 'badge')" t-attf-class="#{cls} mtbg-card__banner mtbg-card__banner--#{item.get('bstyle') or 'default'} #{'is-left' if item.get('bside') == 'left' else 'is-right' if item.get('bside') == 'right' else ''}" t-att-data-show="item['show']"
             t-att-style="'; '.join(x for x in (item_zoom, '--b-bg: %s' % item['bbg'] if item.get('bbg') else '', '--b-text: %s' % item['btext'] if item.get('btext') else '') if x) or None">
            <span class="mtbg-card__banner-in">
                <i t-if="item['icon']" t-attf-class="fa #{item['icon']}" aria-hidden="true"/>
                <t t-call="mtbg_website_cards.card_words"/>
            </span>
        </div>
        <div t-elif="item['look'] == 'strong'" t-att-class="cls" t-att-data-show="item['show']" t-att-style="item_zoom or None">
            <i t-if="item['icon']" t-attf-class="fa #{item['icon']}" aria-hidden="true"/>
            <t t-call="mtbg_website_cards.card_words"/>
        </div>
        <t t-elif="kind == 'title'">
            <!-- its heading level (its size: the theme's H5, times the Text size) -->
            <t t-set="title_cls" t-value="cls + ' h5'"/>
            <h4 t-if="item.get('tag') == 'h4'" t-att-class="title_cls" t-att-data-show="item['show']" t-att-style="item_zoom or None">
                <i t-if="item['icon']" t-attf-class="fa #{item['icon']}" aria-hidden="true"/>
                <t t-call="mtbg_website_cards.card_words"/>
            </h4>
            <h5 t-elif="item.get('tag') == 'h5'" t-att-class="title_cls" t-att-data-show="item['show']" t-att-style="item_zoom or None">
                <i t-if="item['icon']" t-attf-class="fa #{item['icon']}" aria-hidden="true"/>
                <t t-call="mtbg_website_cards.card_words"/>
            </h5>
            <h3 t-else="" t-att-class="title_cls" t-att-data-show="item['show']" t-att-style="item_zoom or None">
                <i t-if="item['icon']" t-attf-class="fa #{item['icon']}" aria-hidden="true"/>
                <t t-call="mtbg_website_cards.card_words"/>
            </h3>
        </t>
        <div t-elif="kind == 'countdown'" t-attf-class="#{cls} #{val.get('class') or ''}" t-att-data-show="item['show']" t-att-style="item_zoom or None"
             t-att-data-deadline="val.get('deadline') or None" t-att="val.get('attrs') or {}">
            <span t-attf-class="mtbg-card__countdown-label #{val.get('label_class') or ''}" t-out="item['text'] or val.get('label') or ''"/>
            <span class="mtbg-card__countdown-time"><i t-if="item['icon']" t-attf-class="fa #{item['icon']}" aria-hidden="true"/> <span t-attf-class="mtbg-card__countdown-clock #{val.get('clock_class') or ''}"/></span>
        </div>
        <div t-elif="kind == 'rating'" t-att-class="cls" t-att-data-show="item['show']" t-att-style="item_zoom or None"
             t-att-title="'%s/5' % (val.get('value') or val.get('text'))">
            <t t-set="stars" t-value="round(float(val.get('value') or val.get('text') or 0))"/>
            <t t-foreach="range(1, 6)" t-as="n"><i t-attf-class="fa #{'fa-star' if n &lt;= stars else 'fa-star-o'}" aria-hidden="true"/></t>
            <span t-if="val.get('count')" class="mtbg-card__rating-count" t-out="'(%s)' % val['count']"/>
        </div>
        <div t-elif="kind == 'icons'" t-attf-class="#{cls} #{'has-labels' if item.get('labels') else ''}" t-att-data-show="item['show']"
             t-att-style="'; '.join(x for x in (item_zoom, '--mtbg-icon-size: %s' % (item['size'] / 100.0) if item.get('size') else '', '--mtbg-icon-gap: %s' % (item['gap'] / 100.0) if item.get('gap') else '', '--mtbg-icon-lift: %spx' % item['lift'] if item.get('lift') else '') if x) or None">
            <!-- each rating's meaning on hover and focus (data-tip, cards.scss) -->
            <span t-foreach="val.get('list') or []" t-as="row" class="mtbg-card__icons-row" tabindex="0"
                  t-att-data-tip="row.get('tip') or None" t-att-aria-label="row.get('tip') or None">
                <!-- its name, when the design shows labels (the rows' icons line up after the longest one) -->
                <span t-if="item.get('labels') and row.get('label')" t-attf-class="mtbg-card__icons-label #{text_cls}" t-att-style="text_style or None" t-out="row['label']"/>
                <!-- the site's own icon: a Font Awesome name, or its image (Tour Stats' icon image) -->
                <span class="mtbg-card__icons-set">
                    <t t-foreach="range(1, int(row.get('of') or 5) + 1)" t-as="n">
                        <img t-if="row.get('image')" t-att-src="row['image']" alt="" t-attf-class="mtbg-card__icon-img #{'is-on' if n &lt;= int(row.get('value') or 0) else 'is-off'}"/>
                        <i t-else="" t-attf-class="fa #{row.get('icon') or 'fa-circle'} #{'is-on' if n &lt;= int(row.get('value') or 0) else 'is-off'}" aria-hidden="true"/>
                    </t>
                </span>
            </span>
        </div>
        <!-- "Compare": a box the catalog's compare button reads (its value: the record's id) -->
        <label t-elif="kind == 'compare'" t-attf-class="#{cls} mtbg-card__compare" t-att-data-show="item['show']" t-att-style="item_zoom or None">
            <input type="checkbox" class="mtbg-compare-check" t-att-value="val.get('text')"/>
            <t t-out="item['text'] or val.get('label') or ''"/>
        </label>
        <!-- a round photo, else the first letter of the name -->
        <span t-elif="kind == 'avatar'" t-att-class="cls" t-att-data-show="item['show']" t-att-style="item_zoom or None">
            <img t-if="val.get('image')" class="mtbg-card__avatar" loading="lazy" alt="" t-att-src="val['image']"/>
            <span t-else="" class="mtbg-card__avatar is-initial" aria-hidden="true" t-out="(val.get('text') or '?')[:1].upper()"/>
        </span>
        <!-- photos: thumbnails, a click opens them large (cards_block.js) -->
        <div t-elif="kind == 'photos'" t-att-class="cls" t-att-data-show="item['show']" t-att-style="item_zoom or None">
            <a t-foreach="val.get('list') or []" t-as="photo" class="mtbg-card__photo" t-att-href="photo.get('full') or photo.get('thumb')">
                <img loading="lazy" t-att-src="photo.get('thumb') or photo.get('full')" t-att-alt="photo.get('alt') or ''"/>
            </a>
        </div>
        <!-- an icon only (e.g. the review's platform) -->
        <span t-elif="kind == 'logo'" t-att-class="cls" t-att-data-show="item['show']" t-att-style="item_zoom or None" t-att-title="val.get('tip') or None">
            <i t-attf-class="fa #{val.get('icon') or item['icon'] or 'fa-circle'}" role="img" t-att-aria-label="val.get('tip') or None"/>
        </span>
        <div t-else="" t-attf-class="#{cls} #{'is-clamped' if item.get('lines') else ''}" t-att-data-show="item['show']"
             t-att-style="'; '.join(x for x in (item_zoom, '--mtbg-lines: %s' % item['lines'] if item.get('lines') else '') if x) or None">
            <i t-if="item['icon'] or val.get('icon')" t-attf-class="fa #{val.get('icon') or item['icon']}" aria-hidden="true"/>
            <span class="mtbg-card__words"><t t-call="mtbg_website_cards.card_words"/></span>
            <!-- another text (a review's original language): a link shows one or the other -->
            <span t-if="val.get('alt')" class="mtbg-card__alt" hidden="hidden" t-out="val['alt']"/>
        </div>
        <button t-if="item.get('more') and item.get('lines')" type="button" class="btn btn-link p-0 mtbg-card__more" t-att-data-show="item['show']">Read more</button>
        <button t-if="val.get('alt')" type="button" class="btn btn-link p-0 mtbg-card__alt-toggle" t-att-data-show="item['show']"
                t-att-data-label-alt="val.get('alt_label') or None" t-out="val.get('label') or ''"/>
        </t>
    </template>

    <!-- an item's words: plain text, and field values (a value may carry another module's classes / data, e.g. a
         price that follows the visitor's currency) -->
    <template id="card_words" name="Card field words">
        <t t-foreach="item['segments']" t-as="seg">
            <t t-if="'text' in seg" t-out="seg['text']"/>
            <t t-else="">
                <t t-set="sv" t-value="seg['value']"/>
                <span t-att-class="sv.get('class') or None" t-att="sv.get('attrs') or {}"><span t-att-class="sv.get('inner_class') or None" t-out="sv.get('text')"/></span>
            </t>
        </t>
    </template>

    <!-- the Card Designer's preview: a design on a website page, with the source's sample records (its unsaved
         settings) -->
    <template id="designer_preview" name="Card design preview">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <div id="wrap" t-attf-class="mtbg-cards-preview #{'mtbg-theme-dark' if dark else 'mtbg-theme-light'} #{'is-hovered' if hover else ''}">
                <div class="container py-4">
                    <t t-if="cards_html" t-out="cards_html"/>
                    <p t-else="" class="text-muted">Nothing to show yet: the source has no records.</p>
                </div>
            </div>
        </t>
    </template>
</odoo>
