<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The tiles: desktop rows and phone rows (one shows per screen). Each row keeps its shape (aspect-ratio) and
         its columns their share, so nothing moves while the pictures load; every photo is cropped to its cell at
         its focus point. A tile links to the full picture, which the page lightbox (page_lightbox.js) opens. -->
    <template id="tiles" name="Tiled gallery tiles">
        <div class="mtbg-tg" t-att-data-count="count" t-att-aria-label="gallery_name or None"
             role="group">
            <div t-foreach="screens" t-as="layout" t-attf-class="mtbg-tg-layout mtbg-tg-#{layout['screen']}">
                <div t-foreach="layout['rows']" t-as="row" class="mtbg-tg-row"
                     t-attf-style="aspect-ratio: #{'%.4f' % row['ratio']}">
                    <div t-foreach="row['columns']" t-as="col" class="mtbg-tg-col"
                         t-attf-style="--mtbg-tg-share: #{'%.5f' % col['share']}">
                        <a t-foreach="col['cells']" t-as="cell"
                           class="mtbg-tg-cell" t-att-href="cell['photo']['full']"
                           t-att-data-index="str(cell['photo']['index'])" t-att-data-caption="cell['photo']['caption'] or None"
                           t-attf-style="flex-grow: #{'%.4f' % cell['grow']}">
                            <img loading="lazy" t-att-src="cell['photo']['src']"
                                 t-att-srcset="cell['photo']['srcset'] or None" t-att-sizes="col['sizes']"
                                 t-att-alt="cell['photo']['alt']"
                                 t-att-width="cell['photo']['attachment'].mtbg_width"
                                 t-att-height="cell['photo']['attachment'].mtbg_height"
                                 t-attf-style="object-position: #{cell['photo']['position']}"/>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- The photo gallery (19.0.0.6.5): a main photo, the other photos in a grid of 5 under it ("+N" on the fifth when
         there are more; the rest in the lightbox only), every photo opening in the page's lightbox as one set; a
         thumbnail shows its photo in the main photo's box, the main photo opens the lightbox (19.0.0.6.7). For
         other modules (t-call with ``gallery_photos``: a list of {'src', 'full', 'alt'}, the first the main photo;
         ``gallery_set``: the lightbox set's name; ``gallery_alt``: the alt text when a photo has none); content
         blocks write the same markup by hand (CHANGELOG 19.0.0.6.5). Lazy, every box sized before it loads.
         19.0.0.6.9, all optional (a photo without them is shown as before): ``srcset`` (the main photo's sizes),
         ``main`` (a thumbnail's picture for the main photo's box), ``caption`` (the lightbox's caption), ``width`` (the
         full picture's width, for the lightbox). -->
    <template id="photo_gallery" name="Photo gallery">
        <t t-set="gallery_first" t-value="gallery_photos[:1]"/>
        <t t-set="gallery_rest" t-value="gallery_photos[1:]"/>
        <t t-set="gallery_more" t-value="len(gallery_rest) &gt; 5"/>
        <div t-if="gallery_first" class="mtbg-gallery" t-att-data-mtbg-photo-set="gallery_set or 'gallery'">
            <img class="mtbg-gallery__main" t-att-src="gallery_first[0]['src']"
                 t-att-alt="gallery_first[0].get('alt') or gallery_alt or ''" loading="lazy" decoding="async"
                 width="512" height="341" t-att-data-mtbg-full="gallery_first[0].get('full') or None"
                 t-att-srcset="gallery_first[0].get('srcset') or None"
                 t-att-sizes="(gallery_first[0].get('sizes') or '100vw') if gallery_first[0].get('srcset') else None"
                 t-att-data-mtbg-caption="gallery_first[0].get('caption') or None"
                 t-att-data-mtbg-width="gallery_first[0].get('width') or None"/>
            <div t-if="gallery_rest" class="mtbg-gallery__thumbs">
                <t t-foreach="gallery_rest" t-as="photo">
                    <!-- (19.0.0.6.7: a div, never a span: the website editor merges identical neighbouring spans) -->
                    <div t-if="photo_index &lt; 5" t-attf-class="mtbg-gallery__thumb #{'mtbg-gallery__thumb--more' if photo_index == 4 and gallery_more else ''}"
                         t-att-data-more="'+%s' % (len(gallery_rest) - 4) if photo_index == 4 and gallery_more else None">
                        <img t-att-src="photo['src']" t-att-alt="photo.get('alt') or gallery_alt or ''"
                             loading="lazy" decoding="async" width="96" height="64"
                             t-att-data-mtbg-full="photo.get('full') or None" t-att-data-mtbg-main="photo.get('main') or None"
                             t-att-data-mtbg-caption="photo.get('caption') or None" t-att-data-mtbg-width="photo.get('width') or None"/>
                    </div>
                    <!-- (beyond the grid: not shown, still in the lightbox after the "+N" one) -->
                    <img t-else="" class="mtbg-gallery__hidden" t-att-src="photo['src']"
                         t-att-alt="photo.get('alt') or gallery_alt or ''" loading="lazy" decoding="async" width="96" height="64"
                         t-att-data-mtbg-full="photo.get('full') or None" t-att-data-mtbg-main="photo.get('main') or None"
                         t-att-data-mtbg-caption="photo.get('caption') or None" t-att-data-mtbg-width="photo.get('width') or None"/>
                </t>
            </div>
        </div>
    </template>

    <!-- Tiled Gallery block: saved with only its source (data-gallery: "ids:<attachment ids>", or a record's gallery
         another module offers: "<kind>:<id>", "<kind>:page" (the page's record), e.g. "tour:page") and its corners;
         the tiles are fetched when the page loads (gallery.js) and never saved. -->
    <template id="s_mtbg_gallery" name="Tiled Gallery">
        <section class="s_mtbg_gallery o_not_editable my-3" data-snippet="s_mtbg_gallery" data-name="Tiled Gallery"
                 data-gallery="" contenteditable="false">
            <div class="s_mtbg_gallery_placeholder alert alert-info text-center mb-0">
                <i class="fa fa-th-large me-1"/> Tiled Gallery — choose the photos in the block options.
            </div>
        </section>
    </template>

    <template id="snippets" inherit_id="website.snippets" name="Tiled gallery snippet">
        <!-- among the inner content blocks, next to the GPX blocks -->
        <xpath expr="//t[@t-snippet='website.s_chart']" position="after">
            <t t-snippet="mtbg_tours_gallery.s_mtbg_gallery" string="Tiled Gallery"
               t-thumbnail="/mtbg_tours_gallery/static/src/img/s_mtbg_gallery.svg">
                <keywords>gallery, tiled, tiles, mosaic, photos, pictures, album, grid, jetpack</keywords>
            </t>
        </xpath>
    </template>

</odoo>
