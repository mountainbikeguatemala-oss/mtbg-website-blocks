<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zoho_ref_list" model="ir.ui.view">
        <field name="name">mtbg.zoho.ref.list</field>
        <field name="model">mtbg.zoho.ref</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'error'" decoration-muted="state == 'skipped'" decoration-info="state == 'waiting'"
                  create="0" edit="0">
                <header>
                    <button name="action_mtbg_retry_errors" type="object" string="Retry errors" icon="fa-refresh"/>
                </header>
                <field name="system"/>
                <field name="kind"/>
                <field name="name" class="o_mtbg_full_name"/>
                <field name="zoho_id"/>
                <field name="zoho_parent_id" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'error'"/>
                <field name="error" optional="show"/>
                <field name="last_sync" optional="show"/>
                <field name="retry_after" optional="show"/>
                <field name="res_model" optional="hide"/>
                <field name="res_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_zoho_ref_form" model="ir.ui.view">
        <field name="name">mtbg.zoho.ref.form</field>
        <field name="model">mtbg.zoho.ref</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_mtbg_open_record" type="object" string="Open the Odoo Record" icon="fa-external-link"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="system"/>
                            <field name="kind"/>
                            <field name="name"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                        </group>
                        <group>
                            <field name="zoho_id"/>
                            <field name="zoho_parent_id"/>
                            <field name="zoho_scope_id" invisible="not zoho_scope_id"/>
                            <field name="zoho_url" widget="url" text="Open in Zoho" invisible="not zoho_url"/>
                            <field name="last_sync"/>
                            <field name="fingerprint"/>
                            <field name="error" invisible="not error"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zoho_ref_search" model="ir.ui.view">
        <field name="name">mtbg.zoho.ref.search</field>
        <field name="model">mtbg.zoho.ref</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="zoho_id"/>
                <field name="kind"/>
                <filter name="errors" string="Errors" domain="[('state', '=', 'error')]"/>
                <filter name="waiting" string="Waiting" domain="[('state', '=', 'waiting')]"/>
                <separator/>
                <filter name="books" string="Zoho Books" domain="[('system', '=', 'books')]"/>
                <filter name="expense" string="Zoho Expense" domain="[('system', '=', 'expense')]"/>
                <filter name="shifts" string="Zoho Shifts" domain="[('system', '=', 'shifts')]"/>
                <group>
                    <filter name="by_system" string="Zoho App" context="{'group_by': 'system'}"/>
                    <filter name="by_kind" string="Kind" context="{'group_by': 'kind'}"/>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_zoho_refs" model="ir.actions.act_window">
        <field name="name">Zoho References</field>
        <field name="res_model">mtbg.zoho.ref</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_zoho_log_list" model="ir.ui.view">
        <field name="name">mtbg.zoho.log.list</field>
        <field name="model">mtbg.zoho.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="not ok" create="0" edit="0" delete="0">
                <field name="create_date" string="When"/>
                <field name="app"/>
                <field name="method"/>
                <field name="path"/>
                <field name="status"/>
                <field name="ok"/>
                <field name="message"/>
                <field name="duration_ms" optional="hide"/>
                <field name="res_model" optional="show"/>
                <field name="res_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_zoho_log_search" model="ir.ui.view">
        <field name="name">mtbg.zoho.log.search</field>
        <field name="model">mtbg.zoho.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="path"/>
                <field name="message"/>
                <filter name="failed" string="Failed" domain="[('ok', '=', False)]"/>
                <group>
                    <filter name="by_app" string="Zoho App" context="{'group_by': 'app'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_zoho_log" model="ir.actions.act_window">
        <field name="name">Zoho Sync Log</field>
        <field name="res_model">mtbg.zoho.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
