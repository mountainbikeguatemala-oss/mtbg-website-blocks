<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mtbg.visit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_settings']" position="inside">
                <setting id="mtbg_visit_by_script" help="Anonymous page views are recorded by a light script once the page has loaded, so pages can be cached. Off: recorded while the page is built.">
                    <field name="mtbg_visit_by_script"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
