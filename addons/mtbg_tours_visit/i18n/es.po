#. module: mtbg_tours_visit
#: model_terms:ir.ui.view,arch_db:mtbg_tours_visit.res_config_settings_view_form
msgid ""
"Anonymous page views are recorded by a light script once the page has "
"loaded, so pages can be cached. Off: recorded while the page is built."
msgstr ""
"Las visitas anónimas las registra un script ligero cuando la página ha "
"cargado, para que las páginas se puedan guardar en caché. Desactivado: se "
"registran mientras se construye la página."

