<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A reusable block placed by a page template (models/page_template.py): stored as the block's placeholder,
         filled with its current content when the page renders, like the blocks placed in a description -->
    <template id="tour_el_block" name="Tour page element: reusable block">
        <section class="s_mtbg_content_block o_not_editable my-4" data-snippet="s_mtbg_content_block" data-name="Reusable Block"
                 t-att-data-mtbg-block="mtbg_el['block_id']"><div class="s_mtbg_content_block_placeholder">Reusable block</div></section>
    </template>

    <!-- Page templates on Core's pages: the board (by kind), the side bar list, the form with its elements -->
    <record id="view_page_template_kanban" model="ir.ui.view">
        <field name="name">mtbg.page.template.kanban</field>
        <field name="model">mtbg.page.template</field>
        <field name="arch" type="xml">
            <kanban quick_create="false" class="mtbg_card_kanban" js_class="mtbg_board_kanban" default_group_by="kind">
                <templates>
                    <t t-name="card">
                        <widget name="mtbg_record_card"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_page_template_list" model="ir.ui.view">
        <field name="name">mtbg.page.template.list</field>
        <field name="model">mtbg.page.template</field>
        <field name="arch" type="xml">
            <list js_class="mtbg_sidebar_list">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="is_default"/>
                <field name="line_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_page_template_form" model="ir.ui.view">
        <field name="name">mtbg.page.template.form</field>
        <field name="model">mtbg.page.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_make_default" type="object" string="Make Default" invisible="is_default"
                            help="Use this template for every page of its kind that no other template is assigned to"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Default" bg_color="text-bg-success" invisible="not is_default"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Day tours"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="is_default" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="note" placeholder="For the team; never shown on the website"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        What the page shows, in each insert point, top to bottom. Switch an element off to leave it
                        out of the page: the template remembers it. Elements of extensions installed later show at
                        their usual place until the template places them.
                    </div>
                    <field name="line_ids">
                        <list editable="bottom" decoration-muted="not active">
                            <field name="sequence" widget="handle"/>
                            <field name="slot"/>
                            <field name="element_name"/>
                            <field name="block_id" options="{'no_create': True}" invisible="element_code"/>
                            <field name="element_code" column_invisible="1"/>
                            <field name="active" widget="boolean_toggle" string="Shown"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_page_template_search" model="ir.ui.view">
        <field name="name">mtbg.page.template.search</field>
        <field name="model">mtbg.page.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="tour" string="Tour pages" domain="[('kind', '=', 'tour')]"/>
                <filter name="rental" string="Rental pages" domain="[('kind', '=', 'rental')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_kind" string="Kind" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_page_template" model="ir.actions.act_window">
        <field name="name">Page Templates</field>
        <field name="res_model">mtbg.page.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Lay out tour and rental pages</p>
            <p>A page template decides which elements a page shows and where. The Default of each kind is the page as
                it has always been.</p>
        </field>
    </record>

    <menuitem id="menu_page_template" name="Page Templates" parent="mtbg_tours_core.menu_mtbg_catalog"
              action="action_page_template" sequence="25" groups="website.group_website_designer"/>
</odoo>
