<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The reusable blocks' list, form and search (until 19.0.0.9.0 Catalog's: their ids moved here, see
         migrations/19.0.0.9.0) -->
    <record id="view_content_block_list" model="ir.ui.view">
        <field name="name">mtbg.tours.content.block.list</field>
        <field name="model">mtbg.tours.content.block</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="block_type"/>
                <field name="key" optional="show"/>
                <field name="usage_total"/>
                <field name="website_view_count" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_content_block_form" model="ir.ui.view">
        <field name="name">mtbg.tours.content.block.form</field>
        <field name="model">mtbg.tours.content.block</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mtbg_edit_in_builder" type="object" class="btn-primary"
                            string="Edit in Website Builder" icon="fa-paint-brush"
                            help="Edit the content with the full website builder: blocks, backgrounds, carousels..."/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        This is a <b>shared</b> block: it shows on every page where the <b>Reusable Block</b> building
                        block points to it, and edits (here or with <i>Edit in place</i> in the website editor) apply to
                        all of them. Used on <field name="usage_total" nolabel="1" class="fw-bold"/> page(s).
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="block_type"/>
                        <field name="key"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <field name="body" options="{'codeview': true}"/>
                            <div class="text-muted small mt-2">
                                Layout, backgrounds and carousels: use <b>Edit in Website Builder</b> above. This field
                                is the raw content (HTML view available).
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_content_block_search" model="ir.ui.view">
        <field name="name">mtbg.tours.content.block.search</field>
        <field name="model">mtbg.tours.content.block</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="key"/>
                <filter string="Type" name="group_type" context="{'group_by': 'block_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_content_block" model="ir.actions.act_window">
        <field name="name">Reusable Content Blocks</field>
        <field name="res_model">mtbg.tours.content.block</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
