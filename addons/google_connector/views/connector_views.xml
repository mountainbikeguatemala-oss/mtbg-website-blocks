<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_connector_account_list" model="ir.ui.view">
        <field name="name">google.connector.account.list</field>
        <field name="model">google.connector.account</field>
        <field name="arch" type="xml">
            <list string="Google accounts" create="false">
                <field name="email"/>
                <field name="state" widget="badge" decoration-success="state == 'connected'" decoration-danger="state == 'error'"/>
                <field name="state_reason"/>
                <button name="action_connect" type="object" string="Reconnect" icon="fa-refresh" groups="base.group_system"/>
                <button name="action_disconnect" type="object" string="Disconnect" icon="fa-unlink" groups="base.group_system"/>
            </list>
        </field>
    </record>
    <record id="action_google_connector_account" model="ir.actions.act_window">
        <field name="name">Google accounts</field>
        <field name="res_model">google.connector.account</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_google_connector_log_list" model="ir.ui.view">
        <field name="name">google.connector.log.list</field>
        <field name="model">google.connector.log</field>
        <field name="arch" type="xml">
            <list string="Google sync log" create="false" edit="false">
                <field name="started_at"/>
                <field name="app_code"/>
                <field name="operation"/>
                <field name="account_id"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'failed'"/>
                <field name="created"/>
                <field name="updated"/>
                <field name="skipped"/>
                <field name="failed"/>
                <field name="note"/>
            </list>
        </field>
    </record>
    <record id="action_google_connector_log" model="ir.actions.act_window">
        <field name="name">Google sync log</field>
        <field name="res_model">google.connector.log</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Settings › Google: what the apps using Google link to ("Open Google settings") -->
    <record id="action_google_settings" model="ir.actions.act_window">
        <field name="name">Google</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'google_connector', 'bin_size': False}</field>
    </record>

    <!-- Settings › Google: the setup wizard, the apps' cards -->
    <record id="res_config_settings_view_form_google" model="ir.ui.view">
        <field name="name">res.config.settings.form.google</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Google" string="Google" name="google_connector" logo="/google_connector/static/description/icon.png"
                     groups="base.group_system">
                    <block title="Google connection" name="google_connection">
                        <setting string="Google connection" help="One Google login for every Google app: the Cloud client, the Google accounts, the Maps key. Credentials are entered only in Set up Google.">
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                <button name="%(google_connector.action_google_setup)d" type="action" class="btn btn-primary btn-sm"
                                        icon="fa-google" string="Set up Google"/>
                                <button name="%(google_connector.action_google_setup_check)d" type="action" class="btn btn-secondary btn-sm"
                                        icon="fa-check" string="Check access"/>
                                <button name="%(google_connector.action_google_connector_account)d" type="action" class="btn btn-link btn-sm"
                                        string="Google accounts"/>
                                <button name="%(google_connector.action_google_connector_log)d" type="action" class="btn btn-link btn-sm"
                                        string="Sync log"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Google apps" name="google_apps">
                        <setting string="Apps" help="Each Google app: on or off, and whether it may change things in Google.">
                            <widget name="google_connector_cards"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
