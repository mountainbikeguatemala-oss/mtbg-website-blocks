<?xml version="1.0" encoding="utf-8"?>
<!-- noupdate: an upgrade never switches a job on or off; they follow the cache switch (Settings › Website, and the
     19.0.0.2.0 migration), see mtbg.edge.cache._mtbg_sync_jobs -->
<odoo noupdate="1">
    <!-- catches the purges a save could not send (Cloudflare busy, or another purge seconds before); switched on and
         off with the cache (Settings › Website) -->
    <record id="cron_edge_cache_purge" model="ir.cron">
        <field name="name">Website: empty Cloudflare's page cache after changes</field>
        <field name="model_id" ref="model_mtbg_edge_cache"/>
        <field name="state">code</field>
        <field name="code">model._mtbg_purge_pending()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
    </record>
    <!-- the homepages' re-fill (0.3.0): every night at 00:05 in Guatemala (UTC-6, no daylight saving: Cloudflare drops
         copies nobody asked for), and a minute after each purge (brought forward); switched on and off with the cache -->
    <record id="cron_edge_cache_warm_home" model="ir.cron">
        <field name="name">Website: re-fill Cloudflare's copy of the homepages</field>
        <field name="model_id" ref="model_mtbg_edge_cache"/>
        <field name="state">code</field>
        <field name="code">model._mtbg_warm()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(hours=-6) + relativedelta(days=1)).strftime('%Y-%m-%d 06:05:00')"/>
        <field name="active" eval="False"/>
    </record>
    <!-- the site notice changed by itself (0.6.1, owner: "yes when banner changes"): a departure full from bookings,
         its booking deadline passed, the next one in its place. Every 5 minutes the notice as the pages would draw it
         now is compared with the one they carry; the cache is emptied only when it differs. With the cache. -->
    <record id="cron_edge_cache_banner" model="ir.cron">
        <field name="name">Website: empty Cloudflare's page cache when the site notice changes</field>
        <field name="model_id" ref="model_mtbg_edge_cache"/>
        <field name="state">code</field>
        <field name="code">model._mtbg_banner_check()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
