<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_meta_health" model="ir.cron">
        <field name="name">Meta: check the connection</field>
        <field name="model_id" ref="model_meta_connector_app"/>
        <field name="state">code</field>
        <field name="code">model._cron_health()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="ir_cron_meta_instagram_feed" model="ir.cron">
        <field name="name">Meta: refresh the Instagram feed</field>
        <field name="model_id" ref="model_meta_connector_media"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
</odoo>
