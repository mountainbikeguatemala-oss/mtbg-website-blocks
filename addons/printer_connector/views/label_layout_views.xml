<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bsx_label_layout_form" model="ir.ui.view">
        <field name="name">bsx.label.layout.form</field>
        <field name="model">bsx.label.layout</field>
        <field name="arch" type="xml">
            <form string="Label layout">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Product label"/></h1></div>
                    <group><field name="usage"/></group>
                    <!-- the drag and drop editor and the live label (label_designer.js) -->
                    <field name="elements" widget="bsx_label_designer" nolabel="1"/>
                    <!-- the settings a layout not edited in the editor yet is made from (as before 1.2.0) -->
                    <field name="show_barcode" invisible="1"/>
                    <field name="barcode_height_mm" invisible="1"/>
                    <field name="show_code" invisible="1"/>
                    <field name="code_position" invisible="1"/>
                    <field name="code_font_px" invisible="1"/>
                    <field name="show_name" invisible="1"/>
                    <field name="name_font_px" invisible="1"/>
                    <field name="name_lines" invisible="1"/>
                    <field name="font_bold" invisible="1"/>
                    <field name="show_price" invisible="1"/>
                    <field name="price_font_px" invisible="1"/>
                    <field name="price_position" invisible="1"/>
                    <field name="logo_position" invisible="1"/>
                    <field name="logo_height_mm" invisible="1"/>
                    <field name="logo_rotation" invisible="1"/>
                    <field name="write_date" invisible="1"/>
                    <group>
                        <group string="Label">
                            <field name="tape_mm"/>
                            <field name="length_mm"/>
                            <field name="min_length_mm" invisible="length_mm"/>
                            <field name="max_length_mm" invisible="length_mm"/>
                            <field name="margin_mm"/>
                            <field name="gap_mode"/>
                            <field name="darkness"/>
                        </group>
                        <group string="Logo and font">
                            <field name="logo" widget="image" options="{'size': [0, 64]}"/>
                            <field name="font"/>
                            <field name="font_file" filename="font_file_name" invisible="font != 'custom'"/>
                            <field name="font_file_name" invisible="1"/>
                        </group>
                        <group string="Barcode">
                            <field name="bar_module_dots"/>
                            <field name="barcode_max_mm"/>
                        </group>
                        <group string="Preview sample">
                            <field name="sample_name"/>
                            <field name="sample_code"/>
                            <field name="sample_price"/>
                        </group>
                    </group>
                    <div class="text-muted small">Each screen prints with the first active layout "Used for" it, else the first
                        "Every screen" one. The barcode is the item's barcode, or its code / internal reference when it
                        has none. "My own font": upload the font file (one the business may use) on the layout.</div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bsx_label_layout_list" model="ir.ui.view">
        <field name="name">bsx.label.layout.list</field>
        <field name="model">bsx.label.layout</field>
        <field name="arch" type="xml">
            <list string="Label layouts">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="usage"/>
                <field name="tape_mm"/>
                <field name="length_mm"/>
                <field name="gap_mode"/>
            </list>
        </field>
    </record>

    <record id="action_bsx_label_layout" model="ir.actions.act_window">
        <field name="name">Label layout</field>
        <field name="res_model">bsx.label.layout</field>
        <field name="view_mode">list,form</field>
        <field name="path">label-layout</field>
    </record>

    <menuitem id="menu_bsx_label_layout" name="Label layout" parent="base.menu_administration"
              action="action_bsx_label_layout" sequence="60" groups="base.group_system"/>
</odoo>
