#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/label_print.js:0
msgid "The code is too long: its barcode goes over the max length."
msgstr "El código es muy largo: su código de barras pasa del largo máximo."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/label_print.js:0
msgid "The content is taller than the label: use smaller text or fewer lines."
msgstr ""
"El contenido es más alto que la etiqueta: usa texto más pequeño o menos "
"líneas."

#. module: printer_connector
#: model:ir.model.fields,help:printer_connector.field_bsx_label_layout__font
msgid ""
"The font of the label's text. The fonts come with Odoo; \"My own font\" uses"
" the font file uploaded on this layout."
msgstr ""
"La fuente del texto de la etiqueta. Las fuentes vienen con Odoo; \"Mi propia"
" fuente\" usa el archivo de fuente subido en este diseño."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/label_designer.js:0
#: code:addons/printer_connector/static/src/label_print.js:0
msgid "The label could not print."
msgstr "No se pudo imprimir la etiqueta."

#. module: printer_connector
#. odoo-python
#: code:addons/printer_connector/models/label_layout.py:0
msgid "The label length goes up to 200 mm (0 = automatic)."
msgstr "El largo de la etiqueta llega hasta 200 mm (0 = automático)."

#. module: printer_connector
#. odoo-python
#: code:addons/printer_connector/models/label_layout.py:0
msgid "The logo size goes from 2 to 12 mm."
msgstr "El tamaño del logo va de 2 a 12 mm."

#. module: printer_connector
#. odoo-python
#: code:addons/printer_connector/models/label_layout.py:0
msgid "The logo turns at most 90 degrees either way."
msgstr "El logo gira como máximo 90 grados hacia cada lado."

#. module: printer_connector
#. odoo-python
#: code:addons/printer_connector/models/label_layout.py:0
msgid "The margin can't be negative and the barcode is at least 2 mm high."
msgstr ""
"El margen no puede ser negativo y el código de barras mide al menos 2 mm de "
"alto."

#. module: printer_connector
#. odoo-python
#: code:addons/printer_connector/models/label_layout.py:0
msgid ""
"The minimum length must be at least 10 mm and not above the maximum (200 mm "
"at most)."
msgstr ""
"El largo mínimo debe ser de al menos 10 mm y no pasar del máximo (200 mm "
"como máximo)."

#. module: printer_connector
#. odoo-python
#: code:addons/printer_connector/models/label_layout.py:0
msgid "The name takes 1 to 3 lines."
msgstr "El nombre ocupa de 1 a 3 líneas."

#. module: printer_connector
#. odoo-python
#: code:addons/printer_connector/models/label_layout.py:0
msgid "The print height must be between 3 and 12 mm."
msgstr "El alto de impresión debe estar entre 3 y 12 mm."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/makeid_printer.js:0
msgid "The printer did not connect: is it on and close by? (%s)"
msgstr "La impresora no se conectó: ¿está encendida y cerca? (%s)"

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/makeid_printer.js:0
msgid "The printer does not answer."
msgstr "La impresora no responde."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/makeid_printer.js:0
msgid ""
"The printer reports a problem (code %s): check the labels and that the lid "
"is closed."
msgstr ""
"La impresora reporta un problema (código %s): revisa las etiquetas y que la "
"tapa esté cerrada."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/makeid_printer.js:0
msgid "The printer stays busy."
msgstr "La impresora sigue ocupada."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/makeid_printer.js:0
msgid "The printer stopped answering."
msgstr "La impresora dejó de responder."

#. module: printer_connector
#: model:ir.model.fields,help:printer_connector.field_bsx_label_layout__usage
msgid ""
"The screens that print with this layout. Extensions add their own uses (e.g."
" rental bike labels, client name tags); a screen with no layout of its own "
"uses the first \"Every screen\" one."
msgstr ""
"Las pantallas que imprimen con este diseño. Las extensiones agregan sus "
"propios usos (p. ej. etiquetas de bicis de renta, etiquetas con el nombre "
"del cliente); una pantalla sin diseño propio usa el primero de \"Todas las "
"pantallas\"."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/label_designer.xml:0
#: code:addons/printer_connector/static/src/label_print.xml:0
#: code:addons/printer_connector/static/src/makeid_printer.js:0
msgid ""
"This browser has no Bluetooth printing: use Chrome on Android, Windows or "
"Mac."
msgstr ""
"Este navegador no puede imprimir por Bluetooth: usa Chrome en Android, "
"Windows o Mac."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/label_print.js:0
msgid "This product has no barcode and no internal reference: add one first."
msgstr ""
"Este producto no tiene código de barras ni referencia interna: agrega uno "
"primero."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/label_designer.xml:0
msgid "Top"
msgstr "Arriba"

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/label_designer.xml:0
msgid "Turn (degrees)"
msgstr "Giro (grados)"

#. module: printer_connector
#: model:ir.model.fields,help:printer_connector.field_bsx_label_layout__logo_rotation
msgid "Turn the logo a little, e.g. -15 (counter-clockwise) or 10."
msgstr "Gira un poco el logo, p. ej. -15 (contra las agujas del reloj) o 10."

#. module: printer_connector
#: model:ir.model.fields.selection,name:printer_connector.selection__bsx_label_layout__code_position__below
msgid "Under the barcode"
msgstr "Debajo del código de barras"

#. module: printer_connector
#: model:ir.model.fields.selection,name:printer_connector.selection__bsx_label_layout__price_position__below
msgid "Under the name"
msgstr "Debajo del nombre"

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/label_designer.xml:0
msgid "Upload the logo below (Logo and font)."
msgstr "Sube el logo abajo (Logo y fuente)."

#. module: printer_connector
#: model:ir.model.fields,field_description:printer_connector.field_bsx_label_layout__usage
msgid "Used for"
msgstr "Usado para"

#. module: printer_connector
#: model:ir.model.fields,help:printer_connector.field_bsx_label_layout__bar_module_dots
msgid ""
"Width of the thinnest bar, in printer dots (0.125 mm). Wider bars scan more "
"easily; it is reduced automatically when the code is too long."
msgstr ""
"Ancho de la barra más delgada, en puntos de la impresora (0.125 mm). Las "
"barras más anchas se escanean más fácil; se reduce sola cuando el código es "
"muy largo."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/label_designer.xml:0
msgid "· Row"
msgstr "· Fila"

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/label_designer.xml:0
msgid "Spacing (mm)"
msgstr "Espacio (mm)"
