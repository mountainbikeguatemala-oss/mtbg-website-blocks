#: code:addons/printer_connector/static/src/label_print.js:0
msgid "\"My own font\" has no font file yet: the label uses the device's font."
msgstr ""
"\"Mi propia fuente\" todavía no tiene archivo de fuente: la etiqueta usa la "
"fuente del dispositivo."

#. module: printer_connector
#: model:ir.model.fields,help:printer_connector.field_bsx_label_layout__darkness
msgid "1 (light) to 31 (dark). The MakeID app uses 15."
msgstr "1 (claro) a 31 (oscuro). La app de MakeID usa 15."

