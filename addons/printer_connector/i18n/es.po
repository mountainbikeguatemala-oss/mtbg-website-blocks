msgstr "Los tamaños de texto empiezan en 8."

#. module: printer_connector
#. odoo-python
#: code:addons/printer_connector/models/label_layout.py:0
msgid "The bar width goes from 1 to 6 dots."
msgstr "El ancho de barra va de 1 a 6 puntos."

#. module: printer_connector
#. odoo-python
#: code:addons/printer_connector/models/label_layout.py:0
msgid "The barcode max length goes from 10 to 200 mm."
msgstr "El largo máximo del código de barras va de 10 a 200 mm."

#. module: printer_connector
#: model:ir.model.fields,help:printer_connector.field_bsx_label_layout__barcode_max_mm
msgid "The bars get thinner (down to 1 dot) to keep the barcode this short."
msgstr "Las barras se adelgazan (hasta 1 punto) para que el código de barras no pase de este largo."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/label_print.js:0
msgid "The code has characters a barcode can't hold."
msgstr "El código tiene caracteres que un código de barras no puede llevar."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/label_print.js:0
msgid "The code is too long: its barcode goes over the max length."
msgstr "El código es muy largo: su código de barras pasa del largo máximo."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/label_print.js:0
msgid "The content is taller than the label: use smaller text or fewer lines."
msgstr "El contenido es más alto que la etiqueta: usa texto más pequeño o menos líneas."

#. module: printer_connector
#: model_terms:ir.ui.view,arch_db:printer_connector.view_bsx_label_layout_form
msgid ""
"The first active layout in the list is the one every screen prints with.\n"
"                        The barcode is the item's barcode, or its code / internal reference when it has none."
msgstr "El primer diseño activo de la lista es con el que imprimen todas las pantallas. El código de barras es el código de barras del artículo, o su código / referencia interna si no tiene."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/label_print.js:0
msgid "The label could not print."
msgstr "No se pudo imprimir la etiqueta."

#. module: printer_connector
#. odoo-python
#: code:addons/printer_connector/models/label_layout.py:0
msgid "The label length goes up to 200 mm (0 = automatic)."
msgstr "El largo de la etiqueta llega hasta 200 mm (0 = automático)."

#. module: printer_connector
#. odoo-python
#: code:addons/printer_connector/models/label_layout.py:0
msgid "The margin can't be negative and the barcode is at least 2 mm high."
msgstr "El margen no puede ser negativo y el código de barras mide al menos 2 mm de alto."

#. module: printer_connector
#. odoo-python
#: code:addons/printer_connector/models/label_layout.py:0
msgid ""
"The minimum length must be at least 10 mm and not above the maximum (200 mm "
"at most)."
msgstr "El largo mínimo debe ser de al menos 10 mm y no pasar del máximo (200 mm como máximo)."

#. module: printer_connector
#. odoo-python
#: code:addons/printer_connector/models/label_layout.py:0
msgid "The name takes 1 to 3 lines."
msgstr "El nombre ocupa de 1 a 3 líneas."

#. module: printer_connector
#. odoo-python
#: code:addons/printer_connector/models/label_layout.py:0
msgid "The print height must be between 3 and 12 mm."
msgstr "El alto de impresión debe estar entre 3 y 12 mm."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/makeid_printer.js:0
msgid "The printer did not connect: is it on and close by? (%s)"
msgstr "La impresora no se conectó: ¿está encendida y cerca? (%s)"

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/makeid_printer.js:0
msgid "The printer does not answer."
msgstr "La impresora no responde."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/makeid_printer.js:0
msgid ""
"The printer reports a problem (code %s): check the labels and that the lid "
"is closed."
msgstr "La impresora reporta un problema (código %s): revisa las etiquetas y que la tapa esté cerrada."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/makeid_printer.js:0
msgid "The printer stays busy."
msgstr "La impresora sigue ocupada."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/makeid_printer.js:0
msgid "The printer stopped answering."
msgstr "La impresora dejó de responder."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/label_print.xml:0
#: code:addons/printer_connector/static/src/makeid_printer.js:0
msgid ""
"This browser has no Bluetooth printing: use Chrome on Android, Windows or "
"Mac."
msgstr "Este navegador no puede imprimir por Bluetooth: usa Chrome en Android, Windows o Mac."

#. module: printer_connector
#. odoo-javascript
#: code:addons/printer_connector/static/src/label_print.js:0
msgid "This product has no barcode and no internal reference: add one first."
msgstr "Este producto no tiene código de barras ni referencia interna: agrega uno primero."

#. module: printer_connector
#: model:ir.model.fields.selection,name:printer_connector.selection__bsx_label_layout__price_position__below
msgid "Under the name"
msgstr "Debajo del nombre"

#. module: printer_connector
#: model:ir.model.fields,help:printer_connector.field_bsx_label_layout__bar_module_dots
msgid ""
"Width of the thinnest bar, in printer dots (0.125 mm). Wider bars scan more "
"easily; it is reduced automatically when the code is too long."
msgstr "Ancho de la barra más delgada, en puntos de la impresora (0.125 mm). Las barras más anchas se escanean más fácil; se reduce sola cuando el código es muy largo."
