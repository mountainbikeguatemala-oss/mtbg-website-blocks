<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Reviews page's preview draws the block on the server: the reviews' styles in its head (review_sync_assets).
         On the site's pages the blocks draw themselves once their code is in: static/src/js/review_assets.js loads
         the code and the styles together. -->
    <template id="review_assets_head" inherit_id="web.frontend_layout" name="Reviews styles (the Reviews page's preview)">
        <xpath expr="//t[@t-call-assets='web.assets_frontend']" position="after">
            <t t-if="review_sync_assets">
                <t t-call-assets="website_review_sync.assets_reviews" t-js="false"/>
            </t>
        </xpath>
    </template>
</odoo>
