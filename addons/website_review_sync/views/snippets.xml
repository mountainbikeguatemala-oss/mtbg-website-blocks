<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Reviews blocks: each names its preset (data-preset); the block is drawn from the preset on each visit, so
         its look, reviews, layout and texts are set on the Reviews page (Presets) and change every block using it.
         The body is filled by review_preset.js and emptied before saving. -->
    <template id="s_review_slider" name="Reviews">
        <section class="s_review_preset" data-preset="bubbles">
            <div class="s_review_preset_body o_not_editable"/>
        </section>
    </template>

    <template id="s_review_slider_cards" name="Reviews (cards)">
        <section class="s_review_preset" data-preset="cards">
            <div class="s_review_preset_body o_not_editable"/>
        </section>
    </template>

    <template id="s_review_slider_dark" name="Reviews (dark)">
        <section class="s_review_preset" data-preset="dark">
            <div class="s_review_preset_body o_not_editable"/>
        </section>
    </template>

    <template id="s_review_slider_site" name="Reviews (site colors)">
        <section class="s_review_preset" data-preset="site">
            <div class="s_review_preset_body o_not_editable"/>
        </section>
    </template>

    <template id="s_review_wall" name="Reviews Wall">
        <section class="s_review_preset" data-preset="wall">
            <div class="s_review_preset_body o_not_editable"/>
        </section>
    </template>

    <template id="snippets" inherit_id="website.snippets" name="Reviews building block">
        <!-- a Reviews category of its own in the editor's Blocks panel -->
        <xpath expr="//snippets[@id='snippet_groups']/t[@id='installed_snippets_hook']" position="before">
            <t snippet-group="reviews" t-snippet="website.s_snippet_group" string="Reviews"
               t-thumbnail="/website_review_sync/static/src/img/s_review_slider.svg"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="website_review_sync.s_review_slider" string="Reviews" group="reviews"
               t-thumbnail="/website_review_sync/static/src/img/s_review_slider.svg"
               t-image-preview="/website_review_sync/static/src/img/s_review_slider_preview.svg">
                <keywords>reviews, testimonials, google, tripadvisor, rating, stars, slider, speech bubbles</keywords>
            </t>
            <t t-snippet="website_review_sync.s_review_slider_cards" string="Reviews (cards)" group="reviews"
               t-thumbnail="/website_review_sync/static/src/img/s_review_slider.svg"
               t-image-preview="/website_review_sync/static/src/img/s_review_slider_cards_preview.svg">
                <keywords>reviews, testimonials, cards, slider</keywords>
            </t>
            <t t-snippet="website_review_sync.s_review_slider_dark" string="Reviews (dark)" group="reviews"
               t-thumbnail="/website_review_sync/static/src/img/s_review_slider.svg"
               t-image-preview="/website_review_sync/static/src/img/s_review_slider_dark_preview.svg">
                <keywords>reviews, testimonials, dark, slider</keywords>
            </t>
            <t t-snippet="website_review_sync.s_review_slider_site" string="Reviews (site colors)" group="reviews"
               t-thumbnail="/website_review_sync/static/src/img/s_review_slider.svg"
               t-image-preview="/website_review_sync/static/src/img/s_review_slider_site_preview.svg">
                <keywords>reviews, testimonials, recent reviews, brand, theme colors, slider</keywords>
            </t>
            <t t-snippet="website_review_sync.s_review_wall" string="Reviews Wall" group="reviews"
               t-thumbnail="/website_review_sync/static/src/img/s_review_wall.svg"
               t-image-preview="/website_review_sync/static/src/img/s_review_wall_preview.svg">
                <keywords>reviews, testimonials, all reviews, wall, google, tripadvisor, filter</keywords>
            </t>
        </xpath>
    </template>
</odoo>
