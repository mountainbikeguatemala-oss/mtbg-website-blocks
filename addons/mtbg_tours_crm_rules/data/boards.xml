<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- the contact rule boards (Core's): the kanban's Board dropdown -->
    <record id="board_rule_state" model="mtbg.board">
        <field name="name">On / off</field>
        <field name="res_model">mtbg.crm.rule</field>
        <field name="group_by">state</field>
        <field name="order">sequence asc</field>
        <field name="sequence">10</field>
    </record>
    <record id="board_rule_source" model="mtbg.board">
        <field name="name">By source</field>
        <field name="res_model">mtbg.crm.rule</field>
        <field name="group_by">source</field>
        <field name="order">sequence asc</field>
        <field name="sequence">20</field>
    </record>
</odoo>
