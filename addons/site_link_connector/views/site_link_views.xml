<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_site_link_list" model="ir.ui.view">
        <field name="name">site.link.list</field>
        <field name="model">site.link</field>
        <field name="arch" type="xml">
            <list string="Linked Sites">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="base_url"/>
                <field name="db_name"/>
                <field name="role"/>
                <field name="last_check_at"/>
                <field name="last_check_ok" widget="boolean"/>
                <button name="action_test_connection" type="object" string="Test connection" icon="fa-plug"/>
            </list>
        </field>
    </record>

    <record id="view_site_link_form" model="ir.ui.view">
        <field name="name">site.link.form</field>
        <field name="model">site.link</field>
        <field name="arch" type="xml">
            <form string="Linked Site">
                <header>
                    <button name="action_test_connection" type="object" string="Test connection" class="btn-primary"
                            icon="fa-plug"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_log" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="log_count" widget="statinfo" string="Failed Calls"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Shop"/></h1>
                    </div>
                    <group>
                        <group string="The Other Site">
                            <field name="base_url" placeholder="https://shop.example.com"/>
                            <field name="db_name"/>
                            <field name="api_key" password="True"/>
                            <field name="role"/>
                        </group>
                        <group string="Calls">
                            <field name="timeout"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Last Test" invisible="not last_check_at">
                        <field name="last_check_at"/>
                        <field name="last_check_ok"/>
                        <field name="last_check_message" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_site_link" model="ir.actions.act_window">
        <field name="name">Linked Sites</field>
        <field name="res_model">site.link</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Link another Odoo site</p>
            <p>Its address, database and an API key of a technical user there (that user needs the group
                "Site Link: calls from a linked site" on the other site).</p>
        </field>
    </record>

    <record id="view_site_link_log_list" model="ir.ui.view">
        <field name="name">site.link.log.list</field>
        <field name="model">site.link.log</field>
        <field name="arch" type="xml">
            <list string="Failed Calls" create="0" edit="0">
                <field name="create_date" string="When"/>
                <field name="site_id"/>
                <field name="model"/>
                <field name="method"/>
                <field name="status"/>
                <field name="message"/>
                <field name="duration_ms" optional="hide"/>
                <field name="create_uid" string="By" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_site_link_log_form" model="ir.ui.view">
        <field name="name">site.link.log.form</field>
        <field name="model">site.link.log</field>
        <field name="arch" type="xml">
            <form string="Failed Call" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="When"/>
                            <field name="site_id"/>
                            <field name="create_uid" string="By"/>
                        </group>
                        <group>
                            <field name="model"/>
                            <field name="method"/>
                            <field name="status"/>
                            <field name="duration_ms"/>
                        </group>
                    </group>
                    <field name="message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_site_link_log" model="ir.actions.act_window">
        <field name="name">Site Link: Failed Calls</field>
        <field name="res_model">site.link.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
